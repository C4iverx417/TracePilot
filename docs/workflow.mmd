---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	check_input(check_input)
	retrieve(retrieve)
	assess(assess)
	generate(generate)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> check_input;
	assess -.-> finish;
	assess -.-> generate;
	assess -.-> retrieve;
	check_input -.-> finish;
	check_input -.-> retrieve;
	generate --> finish;
	retrieve --> assess;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

