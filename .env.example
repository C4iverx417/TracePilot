# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# mock = no network, placeholder answers. openai = any OpenAI-compatible endpoint.
TRACEPILOT_PROVIDER=mock

# Only needed when TRACEPILOT_PROVIDER=openai
OPENAI_API_KEY=
# Change for DeepSeek / DashScope / local servers that speak the same API
OPENAI_BASE_URL=https://api.openai.com/v1
TRACEPILOT_MODEL=gpt-4o-mini

TRACEPILOT_TEMPERATURE=0.2
TRACEPILOT_MAX_TOKENS=512
TRACEPILOT_TIMEOUT_S=30
