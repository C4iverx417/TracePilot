# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# mock = no network, placeholder answers. openai = any OpenAI-compatible endpoint.
TRACEPILOT_PROVIDER=mock

# Only needed when TRACEPILOT_PROVIDER=openai
OPENAI_API_KEY=
# Change for DeepSeek / DashScope / local servers that speak the same API
OPENAI_BASE_URL=https://api.openai.com/v1
TRACEPILOT_MODEL=gpt-4o-mini

TRACEPILOT_TEMPERATURE=0.2
TRACEPILOT_MAX_TOKENS=512
TRACEPILOT_TIMEOUT_S=30

# --- Retrieval (U02) ---
# fastembed = local multilingual model (downloads ~220MB on first use); fake = random vectors for tests
TRACEPILOT_EMBEDDING=fastembed
TRACEPILOT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Characters per chunk. The model above only reads the first 128 tokens of each chunk.
TRACEPILOT_CHUNK_SIZE=400
TRACEPILOT_TOP_K=8
TRACEPILOT_PROJECT=data/sources/pydantic/project.json
# hybrid = BM25 + vector fused with RRF; vector / keyword = a single channel (U06)
TRACEPILOT_RETRIEVAL=hybrid
# Candidates per channel before fusion; TOP_K chunks (max 8) go to the model
TRACEPILOT_CANDIDATES=20
# At most this many chunks from one document go into the model context (U07)
TRACEPILOT_PER_DOCUMENT=2

# --- Workflow (U08) ---
# graph = LangGraph workflow with evidence assessment and re-retrieval; rag = single-pass baseline
TRACEPILOT_ENGINE=graph
TRACEPILOT_MAX_ROUNDS=3
TRACEPILOT_MAX_MODEL_CALLS=8
TRACEPILOT_DEADLINE_S=60
